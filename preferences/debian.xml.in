<image>
    <!-- Debian/derivative Preferences -->
    <preferences profiles="common_debian">
        <version>@VERSION@</version>
        <packagemanager>apt</packagemanager>
        <bootsplash-theme>ceratopsian</bootsplash-theme>
        <bootloader-theme>live-theme</bootloader-theme>
        <locale>@LOCALE@</locale>
        <timezone>@TIMEZONE@</timezone>
    </preferences>
</image>
