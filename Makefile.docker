#!/usr/bin/make -f

SHELL := /bin/bash
COMPOSE := docker compose
SERVICE := builder

.PHONY: all help docker-build docker-shell docker-down FORCE

# Explicit no-op rule so GNU Make's own makefile-remake check doesn't
# match this file's own name against the catch-all %: pattern below.
Makefile.docker: ;

all: help

help:
	@echo "Usage: make -f Makefile.docker <target> [ARGS...]"
	@echo ""
	@echo "  docker-build            - Build (or rebuild) the builder image"
	@echo "  docker-shell            - Open an interactive shell in the builder container"
	@echo "  docker-down             - Remove containers and the kiwi package-cache volume"
	@echo ""
	@echo "  Anything else is forwarded into the container's own Makefile, e.g.:"
	@echo "  <platform> DISTRO=...   - make <platform> DISTRO=... [TIER=...] [RELEASE=...]"
	@echo "  lint / format / clean   - runs the same target inside the container"
	@echo ""
	@echo "  Foreign-arch platforms (e.g. minix-neox8h, odroid-u3, asus-tf101) run"
	@echo "  the builder container itself under QEMU emulation, matching the"
	@echo "  platform's arch. This requires the Docker host to have QEMU binfmt_misc"
	@echo "  interpreters registered once, e.g.:"
	@echo "    docker run --privileged --rm tonistiigi/binfmt --install all"

docker-build:
	$(COMPOSE) build

docker-shell:
	$(COMPOSE) run --rm $(SERVICE) bash

docker-down:
	$(COMPOSE) down -v

%: FORCE
	@arch=$$(grep "name=\"$@\"" includes/profiles.xml | grep -o 'arch="[^"]*"' | cut -d'"' -f2); \
	case "$$arch" in \
		x86_64) platform=linux/amd64 ;; \
		i686|i586) platform=linux/386 ;; \
		armv7l) platform=linux/arm/v7 ;; \
		aarch64) platform=linux/arm64 ;; \
		*) platform=linux/amd64 ;; \
	esac; \
	DOCKER_PLATFORM=$$platform $(COMPOSE) run --rm $(SERVICE) make $@ \
		$(if $(DISTRO),DISTRO=$(DISTRO)) \
		$(if $(TIER),TIER=$(TIER)) \
		$(if $(RELEASE),RELEASE=$(RELEASE))

FORCE:
