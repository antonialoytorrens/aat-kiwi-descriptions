#!/usr/bin/make -f

SHELL := /bin/bash

include common.mk

DISTRO  ?=
TIER    ?= $(DEFAULT_TIER)
RELEASE ?=
COMPOSE := docker compose
SERVICE := builder

FORWARD_TARGETS := $(PLATFORMS) lint format clean bsp-pull

.PHONY: all help docker-build docker-shell docker-down $(FORWARD_TARGETS)

all: help

help:
	@echo "Usage: make -f Makefile.docker <platform> DISTRO=<$(DISTRO_ALT)> TIER=<workstation|server> [RELEASE=<release>]"
	@echo "Example (native arch):  make -f Makefile.docker pc-x86_64 DISTRO=debian TIER=workstation"
	@echo "Example (foreign arch): make -f Makefile.docker asus-tf101 DISTRO=debian TIER=workstation"
	@echo ""
	@echo "Available platforms and their distros:"
	@for p in $(PLATFORMS); do \
		distros=$$(printf '%s\n' $(PROFILES) | grep "^$${p}_" | sed "s/^$${p}_//" | tr '\n' ' '); \
		echo "  $$p: $$distros"; \
	done
	@echo ""
	@echo "Permitted releases per distro (first is the default):"
	@for dr in $(RELEASES); do \
		d=$${dr%%:*}; r=$${dr#*:}; \
		echo "  $$d: $${r//,/ }"; \
	done
	@echo ""
	@echo "Docker-only targets:"
	@echo "  docker-build   - Build (or rebuild) the builder image"
	@echo "  docker-shell   - Open an interactive shell in the builder container"
	@echo "  docker-down    - Remove containers and the kiwi package-cache volume"
	@echo ""
	@echo "Forwarded into the container's own Makefile (same usage as make there):"
	@echo "  <platform> DISTRO=...  clean  lint  format  bsp-pull"
	@echo ""
	@echo "  Foreign-arch platforms (e.g. minix-neox8h, odroid-u3, asus-tf101) run"
	@echo "  the builder container itself under QEMU emulation, matching the"
	@echo "  platform's arch. This requires the Docker host to have QEMU binfmt_misc"
	@echo "  interpreters registered once, e.g.:"
	@echo "    docker run --privileged --rm tonistiigi/binfmt --install all"

docker-build:
	$(COMPOSE) build

docker-shell:
	$(COMPOSE) run --rm $(SERVICE) bash

docker-down:
	$(COMPOSE) down -v

$(FORWARD_TARGETS):
	@arch=$$(grep "name=\"$@\"" includes/profiles.xml | grep -o 'arch="[^"]*"' | cut -d'"' -f2); \
	case "$$arch" in \
		x86_64) platform=linux/amd64 ;; \
		i686|i586) platform=linux/386 ;; \
		armv7l) platform=linux/arm/v7 ;; \
		aarch64) platform=linux/arm64 ;; \
		*) platform=linux/amd64 ;; \
	esac; \
	DOCKER_PLATFORM=$$platform $(COMPOSE) run --rm $(SERVICE) make $@ \
		$(if $(DISTRO),DISTRO=$(DISTRO)) \
		$(if $(TIER),TIER=$(TIER)) \
		$(if $(RELEASE),RELEASE=$(RELEASE))
