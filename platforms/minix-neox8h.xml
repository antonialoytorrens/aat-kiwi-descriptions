<image>
    <!-- Minix NEO X8-H -->
    <preferences profiles="minix-neox8h">
        <type image="oem" initrd_system="dracut" filesystem="btrfs" bootpartition="true" bootfilesystem="fat16" bootpartsize="256" firmware="custom" editbootconfig="minix-neox8h/boot/edit_boot_config.sh">
            <bootloader name="custom"/>
            <oemconfig>
                <oem-resize>true</oem-resize>
            </oemconfig>
        </type>
    </preferences>

    <!-- Debian -->
    <packages type="image" profiles="minix-neox8h_debian">
        <package name="linux-image-m8x"/>
        <package name="u-boot-tools"/>
        <!-- Firmware is included in bsp repository -->
    </packages>
</image>
