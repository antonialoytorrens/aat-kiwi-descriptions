<image>
    <!-- Asus TF101 -->
    <preferences profiles="asus-tf101">
        <type image="oem" initrd_system="dracut" filesystem="ext4" bootpartition="true" bootfilesystem="fat16" bootpartsize="256" firmware="custom">
            <bootloader name="custom"/>
            <oemconfig>
                <oem-resize>true</oem-resize>
            </oemconfig>
        </type>
    </preferences>

    <!-- Debian -->
    <packages type="image" profiles="asus-tf101_debian">
        <package name="linux-image-asus-tf101"/>
        <package name="u-boot-asus-tf101"/>
        <package name="u-boot-menu"/>
    </packages>

    <!-- pmOS -->
    <packages type="image" profiles="asus-tf101_pmos">
        <package name="linux-asus-tf101"/>
        <package name="postmarketos-base"/>
    </packages>
</image>
