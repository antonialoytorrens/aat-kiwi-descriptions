<image>

    <preferences profiles="odroid">
        <type image="oem" initrd_system="dracut" filesystem="ext4" bootpartsize="128">
            <oemconfig>
                <oem-resize>true</oem-resize>
            </oemconfig>
        </type>
    </preferences>

    <!-- Debian -->
    <packages type="image" profiles="odroid_debian">
        <package name="linux-image-armmp"/>
        <package name="u-boot-tools"/>
    </packages>

    <!-- Alpine -->
    <packages type="image" profiles="odroid_alpine">
        <package name="linux-lts"/>
        <package name="uboot-tools"/>
    </packages>

    <!-- PostmarketOS -->
    <packages type="image" profiles="odroid_pmos">
        <package name="linux-odroid-u2"/> <!-- Example specific kernel if available in pmos -->
        <package name="postmarketos-base"/>
    </packages>
</image>
