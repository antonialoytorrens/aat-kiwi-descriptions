<image>

    <preferences profiles="x86_64">
        <type image="oem" initrd_system="dracut" filesystem="ext4" bootloader="grub2">
            <boot-partition-size>512</boot-partition-size>
            <oemconfig>
                <oem-resize>true</oem-resize>
            </oemconfig>
        </type>
    </preferences>


    <!-- Debian packages -->
    <packages type="image" profiles="x86_64_debian">
        <package name="linux-image-amd64"/>
        <package name="grub-pc"/>
        <package name="grub-efi-amd64-bin"/>
    </packages>


    <!-- Alpine packages -->
    <packages type="image" profiles="x86_64_alpine">
        <package name="linux-lts"/>
        <package name="grub"/>
        <package name="grub-efi"/>
    </packages>

    <!-- PostmarketOS packages -->
    <packages type="image" profiles="x86_64_pmos">
        <package name="linux-lts"/>
        <package name="postmarketos-base"/>
    </packages>
</image>
