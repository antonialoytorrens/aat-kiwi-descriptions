<profiles>
    <!-- Common Profiles -->
    <profile name="common_debian" description="Common Debian Base Profile"/>
    <profile name="common_alpine" description="Common Alpine Base Profile"/>

    <!-- x86_64 Profiles -->
    <profile name="x86_64" description="Standard x86_64 Image" arch="x86_64"/>
    <profile name="x86_64_debian" description="Standard x86_64 Image (Debian)" arch="x86_64">
        <requires profile="x86_64"/>
        <requires profile="common_debian"/>
    </profile>
    <profile name="x86_64_alpine" description="Standard x86_64 Image (Alpine)" arch="x86_64">
         <requires profile="x86_64"/>
         <requires profile="common_alpine"/>
    </profile>
    <profile name="x86_64_pmos" description="Standard x86_64 Image (PostmarketOS)" arch="x86_64">
         <requires profile="x86_64"/>
        <requires profile="common_alpine"/>
    </profile>

    <!-- i386 Profiles -->
    <profile name="i386" description="Standard i386 Image" arch="i686"/>
    <profile name="i386_debian" description="Standard i386 Image (Debian)" arch="i686">
        <requires profile="i386"/>
        <requires profile="common_debian"/>
    </profile>
    <profile name="i386_alpine" description="Standard i386 Image (Alpine)" arch="i686">
        <requires profile="i386"/>
        <requires profile="common_alpine"/>
    </profile>
    <profile name="i386_pmos" description="Standard i386 Image (PostmarketOS)" arch="i686">
        <requires profile="i386"/>
        <requires profile="common_alpine"/>
    </profile>

    <!-- Raspberry Pi Profiles -->
    <profile name="rpi" description="Raspberry Pi Image" arch="aarch64"/>
    <profile name="rpi_debian" description="Raspberry Pi Image (Debian)" arch="aarch64">
        <requires profile="rpi"/>
        <requires profile="common_debian"/>
    </profile>

    <!-- Odroid U3 Profiles -->
    <profile name="odroid" description="Odroid U3 Image" arch="arm"/>
    <profile name="odroid_debian" description="Odroid U3 Image (Debian)" arch="arm">
        <requires profile="odroid"/>
        <requires profile="common_debian"/>
    </profile>
    <profile name="odroid_alpine" description="Odroid U3 Image (Alpine)" arch="arm">
        <requires profile="odroid"/>
        <requires profile="common_alpine"/>
    </profile>
    <profile name="odroid_pmos" description="Odroid U3 Image (PostmarketOS)" arch="arm">
        <requires profile="odroid"/>
        <requires profile="common_alpine"/>
    </profile>

    <!-- Asus TF101 Profiles -->
    <profile name="tf101" description="Asus TF101 Image" arch="arm"/>
    <profile name="tf101_debian" description="Asus TF101 Image (Debian)" arch="arm">
        <requires profile="tf101"/>
        <requires profile="common_debian"/>
    </profile>
     <profile name="tf101_pmos" description="Asus TF101 Image (PostmarketOS)" arch="arm">
        <requires profile="tf101"/>
        <requires profile="common_alpine"/>
    </profile>
</profiles>
